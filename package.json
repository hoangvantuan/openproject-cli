{
  "name": "@tuanhv/op-cli",
  "version": "0.2.1",
  "description": "A resolving command-line client for OpenProject",
  "license": "MIT",
  "author": "hoangvantuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangvantuan/openproject-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hoangvantuan/openproject-cli/issues"
  },
  "homepage": "https://github.com/hoangvantuan/openproject-cli#readme",
  "keywords": [
    "openproject",
    "cli",
    "command-line",
    "project-management",
    "work-packages",
    "time-tracking"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
