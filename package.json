    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "undici": "^7.15.0",
    "vitest": "^3.2.4"
  }
}
